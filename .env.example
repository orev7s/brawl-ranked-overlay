# Brawl Stars API token from https://developer.brawlstars.com
BRAWL_API_TOKEN=

# Player tag to track (with or without the leading #)
PLAYER_TAG=#2PQ0LRVGR

# HTTP port for the overlay server
PORT=8786

# How often to poll the Brawl Stars API (milliseconds, min 15000)
POLL_MS=20000

# Optional: require ?key= on the control panel + session endpoints
CONTROL_TOKEN=

# Start in demo mode (random matches, no API calls)
DEMO=0

# Shown in the corner of the overlay (leave blank to hide)
OVERLAY_CREDIT=
